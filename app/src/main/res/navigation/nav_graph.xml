<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/testsFragment">

    <!-- Фрагмент списка тестов -->
    <fragment
        android:id="@+id/testsFragment"
        android:name="com.example.groupprojectfirsttry.TestsFragment"
        android:label="Тесты">
        <!-- Здесь будет действие для перехода к TestPassFragment -->
        <action
            android:id="@+id/action_testsFragment_to_testPassFragment"
            app:destination="@id/testPassFragment"
            app:popUpTo="@id/testsFragment" />
    </fragment>

    <!-- Фрагмент прохождения теста -->
    <fragment
        android:id="@+id/testPassFragment"
        android:name="com.example.groupprojectfirsttry.TestPassFragment"
        android:label="Прохождение теста">
        <!-- Аргумент для передачи теста -->
        <argument
            android:name="test"
            app:argType="com.example.groupprojectfirsttry.Test" />
    </fragment>


</navigation>