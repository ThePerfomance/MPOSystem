<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_dashed_blue"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivFinalTestStatus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_blue_light"
        android:padding="6dp"
        android:src="@drawable/test_logo_svg"
        app:tint="@color/AccentColor" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Финальный тест блока"
            android:textColor="@color/OnboardingRedTextColor"
            android:alpha="0.7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Завершите все уроки блока"
            android:textColor="@color/OnboardingRedTextColor"
            android:alpha="0.5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>