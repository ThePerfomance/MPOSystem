<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/AppBackgroundColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Список вопросов (будет наполняться программно) -->
        <LinearLayout
            android:id="@+id/llQuestionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Плашка результата -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvResultBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF1F1"
            app:layout_constraintTop_toBottomOf="@id/llQuestionsContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvResultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Попробуйте ещё раз"
                    android:textColor="#8B0000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Правильных ответов: 0 из 0"
                    android:textColor="#A52A2A"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Кнопка проверки -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitTest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Проверить ответы"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#8E8E93"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cvResultBanner"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0" />

        <!-- Кнопка "Пройти заново" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryTest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Пройти тест заново"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:strokeColor="@color/DividerColor"
            app:layout_constraintTop_toBottomOf="@id/btnSubmitTest" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>