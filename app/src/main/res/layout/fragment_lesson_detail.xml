<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AppBackgroundColor">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/SurfaceColor"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Назад"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBlockTitleDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gray_tag"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Введение в компанию"
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLessonTitleDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="История и ценности компании"
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Selector -->
    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <!-- Video Tab -->
        <LinearLayout
            android:id="@+id/tabVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabVideo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/OnboardingPrimaryTextColor" />

            <TextView
                android:id="@+id/tvTabVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Видео"
                android:textColor="@color/OnboardingPrimaryTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Summary Tab -->
        <LinearLayout
            android:id="@+id/tabSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gray_tag"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabSummary"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/books_svg"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:id="@+id/tvTabSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Саммари"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Test Tab -->
        <LinearLayout
            android:id="@+id/tabTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gray_tag"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabTest"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/test_logo_svg"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:id="@+id/tvTabTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Тест"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTabs">

        <!-- Video Content (Initial) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvVideoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/gradient_background" /> <!-- Placeholder for thumbnail -->

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_play_circle"
                        app:tint="@android:color/white" />

                    <!-- Overlay like in the picture -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="#80000000"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Смотреть на YouTube"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Продолжительность: 15 мин"
                    android:textColor="@color/OnboardingSecondaryTextColor"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSummaryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Здесь будет краткое содержание урока (саммари)..."
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTestContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Здесь будет тест по пройденному материалу..."
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>