<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AppBackgroundColor">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/SurfaceColor"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Назад"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBlockTitleDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gray_tag"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Введение в компанию"
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLessonTitleDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="История и ценности компании"
            android:textColor="@color/OnboardingPrimaryTextColor"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Selector -->
    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <!-- Video Tab -->
        <LinearLayout
            android:id="@+id/tabVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabVideo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/OnboardingPrimaryTextColor" />

            <TextView
                android:id="@+id/tvTabVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Видео"
                android:textColor="@color/OnboardingPrimaryTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Summary Tab -->
        <LinearLayout
            android:id="@+id/tabSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gray_tag"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabSummary"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/books_svg"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:id="@+id/tvTabSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Саммари"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Test Tab -->
        <LinearLayout
            android:id="@+id/tabTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gray_tag"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivTabTest"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/test_logo_svg"
                app:tint="@color/OnboardingSecondaryTextColor" />

            <TextView
                android:id="@+id/tvTabTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Тест"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTabs">

        <!-- Video Content -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvVideoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <WebView
                    android:id="@+id/webViewRutube"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <TextView
                    android:id="@+id/tvVideoDurationDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Продолжительность: 15 мин"
                    android:textColor="@color/OnboardingSecondaryTextColor"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvSummaryContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSummaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:text="Здесь будет краткое содержание урока (саммари)..."
                android:textColor="@color/OnboardingPrimaryTextColor"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Test Content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTestContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbTestLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvNoTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Для этого урока тест не предусмотрен"
                android:textColor="@color/OnboardingSecondaryTextColor"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llTestContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Загрузка вопроса..."
                    android:textColor="@color/OnboardingPrimaryTextColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAnswers"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnTestBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/red_button_left_selector"
                        android:padding="12dp"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/tvTestProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Вопрос 1 из 5"
                        android:textColor="@color/OnboardingSecondaryTextColor"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnTestNext"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/red_button_right_selector"
                        android:padding="12dp"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>